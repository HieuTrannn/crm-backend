# Copy to .env for local development. Never commit .env.
PORT=8080
# Optional local HTTPS (like ASP.NET's https profile). Set both files to also
# serve https://localhost:$HTTPS_PORT. Export the .NET dev certificate with:
#   dotnet dev-certs https --export-path certs/localhost.pem --format PEM --no-password
#   dotnet dev-certs https --trust
# Leave empty in production: Render terminates TLS in front of PORT.
HTTPS_PORT=8443
TLS_CERT_FILE=
TLS_KEY_FILE=
# development | test | production
APP_ENV=development
# App connection as app_user: not the table owner, no BYPASSRLS (NFR-ISO-03).
# Pool size: append &pool_max_conns=10 (NFR-PERF-04).
DATABASE_URL=postgres://app_user:change-me-app-user-password@localhost:5432/crm?sslmode=disable
# Owner role, direct (non-pooled) connection, used only by goose migrations.
MIGRATION_DATABASE_URL=postgres://crm:crm@localhost:5432/crm?sslmode=disable
# Password the first migration gives app_user; must match DATABASE_URL above.
# Use letters, digits and - only: ' \ $ would break the migration's substitution.
APP_USER_PASSWORD=change-me-app-user-password
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
FRONTEND_ORIGIN=http://localhost:3000
